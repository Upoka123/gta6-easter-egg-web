  "rules": {
    "title": "Szabályok",
    "forbidden": [
      {
        "id": "f1",
        "text": "Ne változtasd meg a 12 alállomás sorrendjét. Mindegyiket a meghatározott sorrendben kell aktiválnod."
      },
      {
        "id": "f2",
        "text": "Ne nyomj meg másik gombot, kizárólag az adott állomáshoz tartozót."
      },
      {
        "id": "f3",
        "text": "Ne hagyj ki egyetlen állomást sem."
      },
      {
        "id": "0bh65nqo",
        "text": "Ne próbáld meg nappal aktiválni a végső részt. A Turtle Head Power Station Reactor Two csak 19:00 és 06:00 között jelenik meg."
      },
      {
        "id": "ut4np31i",
        "text": "Ne keverd össze a kapcsolókat és a gombokat. Az állomásokon először az áramellátást kell bekapcsolni."
      },
      {
        "id": "95odgbiy",
        "text": "Ne használj Fast Travelt (taxi, busz, vonat stb.) a folyamat során."
      },
      {
        "id": "nifu8z5w",
        "text": "Ne válts karaktert Jason és Lucia között."
      },
      {
        "id": "bqv76jue",
        "text": "Ne nyomj meg másik kapcsolót az adott állomáson."
      },
      {
        "id": "i4nc4lan",
        "text": "Ne halj meg a folyamat során, mert elveszítheted az addigi előrehaladást."
      },
      {
        "id": "421dw2fd",
        "text": "Ne szakítsd meg a küldetés folyamatát, és ne térj el az előírt sorrendtől."
      }
    ],
    "blocks": []
  },
